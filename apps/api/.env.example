# Copy to .env for local development. Never commit .env.
NODE_ENV=development
APP_ENV=local
APP_VERSION=dev
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
# Comma-separated list of allowed browser origins (the web panel).
CORS_ORIGINS=http://localhost:3001
# Leave empty to disable Sentry locally.
SENTRY_DSN=

# Runtime connection: az_app (RLS applies). Matches pnpm db:up.
DATABASE_URL=postgres://az_app:app@localhost:5433/az_pesquisas
DATABASE_POOL_MAX=10
# Migrations only: az_owner (owner of the tables). Never used by the running API.
DATABASE_MIGRATION_URL=postgres://az_owner:owner@localhost:5433/az_pesquisas
