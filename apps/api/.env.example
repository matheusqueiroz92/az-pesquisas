# Copy to .env for local development. Never commit .env.
NODE_ENV=development
APP_ENV=local
APP_VERSION=dev
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
# Comma-separated list of allowed browser origins (the web panel).
CORS_ORIGINS=http://localhost:3001
# Leave empty to disable Sentry locally.
SENTRY_DSN=
