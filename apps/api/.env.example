# Copy to .env for local development. Never commit .env.
NODE_ENV=development
APP_ENV=local
APP_VERSION=dev
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
# Comma-separated list of allowed browser origins (the web panel).
CORS_ORIGINS=http://localhost:3001
# Leave empty to disable Sentry locally.
SENTRY_DSN=

# Runtime connection: az_app (RLS applies). Matches pnpm db:up.
DATABASE_URL=postgres://az_app:app@localhost:5433/az_pesquisas
DATABASE_POOL_MAX=10
# Migrations only: az_owner (owner of the tables). Never used by the running API.
DATABASE_MIGRATION_URL=postgres://az_owner:owner@localhost:5433/az_pesquisas

# Access token signing key (32+ characters). Local value only; generate a real one with:
#   openssl rand -base64 48
JWT_SECRET=local-development-secret-change-me-0123456789
# Base URL of the web panel (used in password reset links).
PANEL_URL=http://localhost:3001
# Local development: e-mails are written as files here instead of being sent.
MAIL_DIR=.mail

# pnpm seed:admin — first organization and admin (password is never printed).
SEED_ORG_NAME=AZ Pesquisas
SEED_ORG_SLUG=az-pesquisas
SEED_ADMIN_NAME=Matheus Queiroz
SEED_ADMIN_EMAIL=admin@azworkcenter.com.br
SEED_ADMIN_PASSWORD=troque-esta-senha-123
