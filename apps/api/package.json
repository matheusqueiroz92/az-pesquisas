{
  "name": "@az-pesquisas/api",
  "version": "0.0.0",
  "private": true,
  "description": "API do AZ Pesquisas (NestJS + Fastify)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,api -c blue,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=.env --import ./dist/instrument.js dist/main.js\"",
    "start": "node --import ./dist/instrument.js dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/migrate.js",
    "seed:admin": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/seed-admin.js"
  },
  "dependencies": {
    "@az-pesquisas/contracts": "workspace:*",
    "@az-pesquisas/core": "workspace:*",
    "@fastify/helmet": "^13.2.0",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-fastify": "^12.3.3",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@sentry/node": "^11.10.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@az-pesquisas/config": "workspace:*",
    "@nestjs/testing": "^12.3.3",
    "@swc/core": "^1.16.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
