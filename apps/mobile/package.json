{
  "name": "@az-pesquisas/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "App de campo do AZ Pesquisas (Expo): entrevistas offline com banco criptografado",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export:android": "expo export --platform android --output-dir dist-export",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@az-pesquisas/contracts": "workspace:*",
    "@az-pesquisas/core": "workspace:*",
    "@az-pesquisas/design-tokens": "workspace:*",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.3",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.0",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@az-pesquisas/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
