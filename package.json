{
  "name": "az-pesquisas",
  "private": true,
  "description": "AZ Pesquisas — sistema de pesquisas de campo (API, painel web e app offline)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.28.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @az-pesquisas/web test:e2e",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm depcruise && pnpm test:coverage",
    "prepare": "husky",
    "db:up": "docker compose -f infra/compose/docker-compose.local.yml up -d --wait",
    "db:down": "docker compose -f infra/compose/docker-compose.local.yml down",
    "db:reset": "docker compose -f infra/compose/docker-compose.local.yml down -v && docker compose -f infra/compose/docker-compose.local.yml up -d --wait",
    "db:migrate": "pnpm --filter @az-pesquisas/api db:migrate",
    "db:generate": "pnpm --filter @az-pesquisas/api db:generate",
    "seed:admin": "pnpm --filter @az-pesquisas/api seed:admin"
  },
  "devDependencies": {
    "@az-pesquisas/config": "workspace:*",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  },
  "prettier": "@az-pesquisas/config/prettier",
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core"
    ]
  }
}
