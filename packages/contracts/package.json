{
  "name": "@az-pesquisas/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Schemas Zod compartilhados entre API, painel e app: DTOs, permissões e códigos de erro",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@az-pesquisas/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
